{
  "name": "call-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Сервис бронирования календаря звонков (учебный проект Hexlet)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "generate:api": "node scripts/generate-api.mjs",
    "lint": "oxlint",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "yaml": "^2.9.1"
  }
}
