namespace CallCalendar;

/**
 * Слот — полуоткрытый интервал `[start, end)` внутри рабочего дня 09:00–18:00.
 * Длительность слота всегда равна длительности типа; неполный остаток у правого
 * края слотом не является и в сетке не появляется.
 */
model Slot {
  @doc("Начало слота на сетке типа")
  start: LocalTime;

  @doc("Конец слота — `start` плюс длительность типа")
  end: LocalTime;

  @doc("""
    Свободен по единственному определению: интервал не пересекается ни с одной
    бронью и слот не в прошлом (для сегодня — начало строго в будущем).
    Занятые и прошедшие слоты остаются в сетке с `false`.
    """)
  available: boolean;
}

@doc("День окна записи: дата и сетка слотов типа на неё")
model Day {
  date: LocalDate;

  @doc("Все слоты типа на дату, включая занятые и прошедшие")
  slots: Slot[];
}
